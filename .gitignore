# ==========================================
# Niravayak SmartNivas - .gitignore
# ==========================================

# Node / Frontend dependencies & artifacts
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
**/dist/
**/build/
**/out/

# Python bytecode & cache
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables & local secrets
.env
.env.*
!.env.example
*.local

# IDEs & OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp files
*.log
logs/
*.tmp
*.temp
.temp/
.tmp/

# Testing coverage & cache
.coverage
htmlcov/
.pytest_cache/
.unittest_cache/
